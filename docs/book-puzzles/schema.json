{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "En Croissant book puzzle interchange v1",
  "type": "object",
  "required": ["schemaVersion", "book", "problems"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "book": {
      "type": "object",
      "required": ["id", "title", "edition"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "edition": { "type": "string", "minLength": 1 }
      }
    },
    "problems": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/problem" } }
  },
  "$defs": {
    "move": {
      "type": "object",
      "required": ["uci"],
      "properties": {
        "uci": { "type": "string", "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$" },
        "comment": { "type": "string", "default": "" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/move" }, "default": [] }
      }
    },
    "problem": {
      "type": "object",
      "required": [
        "id",
        "order",
        "chapter",
        "page",
        "answerPage",
        "number",
        "fen",
        "prompt",
        "solution"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "chapter": { "type": "string", "minLength": 1 },
        "page": { "type": "string", "minLength": 1 },
        "answerPage": { "type": "string", "minLength": 1 },
        "number": { "type": "string", "minLength": 1 },
        "fen": { "type": "string" },
        "prompt": { "type": "string" },
        "examPrompt": { "type": ["string", "null"] },
        "hints": { "type": "array", "items": { "type": "string" }, "default": [] },
        "explanation": { "type": "string", "default": "" },
        "themes": { "type": "array", "items": { "type": "string" }, "default": [] },
        "solution": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/move" } }
      }
    }
  }
}
